{
  "title": "Knowledge Article Quality Rubric",
  "description": "知识条目 5 维质量评分契约 —— 单一事实来源（Single Source of Truth）。check_quality.py 据此加载评分规则，代码不硬编码阈值/词表/权重。维度参数、空洞词黑名单、标准标签词表、等级边界全在此文件。改动评分规则只改这里。",
  "total_score": 100,
  "grade_boundaries": {"A": 80, "B": 60},
  "dimensions": [
    {
      "name": "summary_quality",
      "label": "摘要质量",
      "type": "summary",
      "max_score": 25,
      "params": {
        "field": "summary",
        "full_length": 50,
        "base_length": 20,
        "full_points": 20,
        "base_points": 12,
        "low_points": 0,
        "keyword_points": 2,
        "keyword_bonus_max": 5,
        "tech_keywords_en": [
          "agent", "agents", "agentic", "llm", "large language model",
          "model", "token", "inference", "training", "fine-tun",
          "embed", "embedding", "transformer", "attention", "rag",
          "retriev", "mcp", "sdk", "api", "runtime", "latency",
          "benchmark", "dataset", "quantiz", "vector", "prompt",
          "context window", "tool-use", "tool use", "multi-agent"
        ],
        "tech_keywords_zh": [
          "代理", "智能体", "模型", "推理", "微调", "向量", "检索",
          "提示词", "上下文", "工具调用", "多智能体", "多代理", "基准",
          "量化", "嵌入", "注意力", "transformer", "token"
        ]
      }
    },
    {
      "name": "tech_depth",
      "label": "技术深度",
      "type": "scale_field",
      "max_score": 25,
      "params": {
        "field": "relevance_score",
        "factor": 25,
        "note": "relevance_score (0-1) × 25 线性映射。relevance_score 已融合 tech_depth 五维加权，是最接近技术深度的现成数据源。"
      }
    },
    {
      "name": "format_compliance",
      "label": "格式规范",
      "type": "format",
      "max_score": 20,
      "params": {
        "points_each": 4,
        "fields": [
          {"name": "id", "check": "nonempty"},
          {"name": "title", "check": "nonempty"},
          {"name": "source", "check": "nonempty"},
          {"name": "url", "check": "url_https"},
          {"name": "category", "check": "nonempty"}
        ],
        "note": "本项目无 status 字段，以 category（open-source/paper-or-talk/article-or-news）替代，与 article.schema.json 字段契约一致。"
      }
    },
    {
      "name": "tag_precision",
      "label": "标签精度",
      "type": "tags",
      "max_score": 15,
      "params": {
        "field": "tags",
        "points_per_standard": 7,
        "optimal_count": 2,
        "format_bonus": 1,
        "standard_tags": [
          "coding-agent", "llm", "mcp", "developer-tools", "open-source",
          "prompt-engineering", "agent-observability", "local-first",
          "cryptography", "anthropic", "ai-agent", "cross-platform",
          "multi-model", "agent-memory", "self-hosted"
        ],
        "tag_pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "note": "标准词表取项目中出现≥2次的高频标签（数据驱动），代表项目既有词汇核心。"
      }
    },
    {
      "name": "buzzword_check",
      "label": "空洞词检测",
      "type": "buzzword",
      "max_score": 15,
      "params": {
        "fields": ["summary", "title"],
        "deduction_per_hit": 5,
        "blacklist_zh": [
          "赋能", "抓手", "闭环", "打通", "全链路", "底层逻辑",
          "颗粒度", "对齐", "拉通", "沉淀", "强大的", "革命性的"
        ],
        "blacklist_en": [
          "groundbreaking", "revolutionary", "game-changing", "game-changer",
          "cutting-edge", "state-of-the-art", "next-generation", "seamless",
          "paradigm shift", "synergy", "world-class", "best-in-class"
        ]
      }
    }
  ]
}
